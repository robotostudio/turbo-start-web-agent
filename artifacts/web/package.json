{
  "name": "@workspace/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#velite": "./.velite/index.js"
  },
  "scripts": {
    "brand:check": "node --experimental-strip-types scripts/brand-check.ts",
    "build": "next build",
    "catalog": "node --experimental-strip-types scripts/generate-catalog.ts && pnpm run gallery",
    "catalog:check": "node --experimental-strip-types scripts/generate-catalog.ts --check",
    "content:check": "velite --strict",
    "dev": "next dev -p ${PORT:-3000} -H 0.0.0.0",
    "format": "biome format --write",
    "gallery": "node --experimental-strip-types scripts/generate-gallery.ts",
    "gallery:check": "node --experimental-strip-types scripts/generate-gallery.ts --check",
    "lint": "biome check",
    "prebuild": "velite",
    "predev": "velite",
    "pretest": "velite",
    "start": "next start -p ${PORT:-3000} -H 0.0.0.0",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "texture": "node --experimental-strip-types scripts/generate-texture.ts",
    "texture:check": "node --experimental-strip-types scripts/generate-texture.ts --check",
    "typecheck": "velite --strict && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@mdx-js/mdx": "^3.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "velite": "^0.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-mdx": "^3.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
