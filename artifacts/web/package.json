{
  "name": "@workspace/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#velite": "./.velite/index.js"
  },
  "scripts": {
    "predev": "velite",
    "dev": "next dev -p ${PORT:-3000} -H 0.0.0.0",
    "prebuild": "velite",
    "build": "next build",
    "start": "next start -p ${PORT:-3000} -H 0.0.0.0",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "velite --strict && tsc --noEmit",
    "content:check": "velite --strict",
    "pretest": "velite",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "clsx": "^2.1.1",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "velite": "^0.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-mdx": "^3.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
