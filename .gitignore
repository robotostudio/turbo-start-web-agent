# Generated by Next.js on every dev run and every build — and NOT identically:
# `next dev` writes an import of ./.next/dev/types/routes.d.ts, `next build`
# writes ./.next/types/routes.d.ts. Tracked, it therefore flip-flops on every
# dev<->build cycle and shows up as a spurious diff nobody made. An agent that
# verifies its work in a browser (which AGENTS.md rule 4 asks for) runs the dev
# server, dirties this file, and commits it — which is exactly what happened on
# 2026-08-20, complete with a PR description crediting the accident as the work.
# create-next-app gitignores this file for the same reason. Verified safe here:
# `pnpm typecheck` passes with the file absent, so nothing depends on it being
# committed.
next-env.d.ts
.env
.env.local
.env.*.local
.DS_Store
docs/superpowers/
.vercel
.env*
